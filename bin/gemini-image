#!/usr/bin/env bash
#
# gemini-image: generate an image from a text prompt with the Gemini API.
#
# Reads the API key from the macOS Keychain item "gemini-api-key", created with:
#
#   security add-generic-password -a "$USER" -s gemini-api-key -w

set -euo pipefail

MODEL="${GEMINI_IMAGE_MODEL:-gemini-nano-banana-2.1}"
ENDPOINT="https://generativelanguage.googleapis.com/v1beta/interactions"

die() {
  echo "gemini-image: $*" >&2
  exit 1
}

usage() {
  cat >&2 <<EOF
Usage: gemini-image [-m model] [-o output] [-n] <prompt...>

  -m model   model ID (default: ${MODEL}; or set GEMINI_IMAGE_MODEL)
  -o output  output file (default: gemini-<timestamp>.<ext> in the current dir)
  -n         don't open the image after saving

Example:
  gemini-image a cozy isometric cabin in a snowy forest at dusk
EOF
  exit 1
}

output=""
open_after=1
while getopts ":m:o:nh" opt; do
  case "${opt}" in
    m) MODEL="${OPTARG}" ;;
    o) output="${OPTARG}" ;;
    n) open_after=0 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -gt 0 ]] || usage
prompt="$*"

for bin in curl jq security base64; do
  command -v "${bin}" >/dev/null 2>&1 || die "required binary not found: ${bin}"
done

api_key="$(security find-generic-password -s gemini-api-key -w 2>/dev/null)" \
  || die "Keychain item 'gemini-api-key' not found"

body="$(jq -n --arg model "${MODEL}" --arg input "${prompt}" \
  '{model: $model, input: $input, store: false}')"

echo "Generating with ${MODEL}..." >&2

# The key is passed as a header file so it doesn't appear in `ps` output.
response="$(curl -sS -X POST "${ENDPOINT}" \
  -H @<(printf 'x-goog-api-key: %s\n' "${api_key}") \
  -H "Content-Type: application/json" \
  -d "${body}")" || die "request failed"

jq -e . >/dev/null 2>&1 <<<"${response}" || die "unexpected response: ${response:0:500}"

if err="$(jq -er '.error.message // empty' <<<"${response}" 2>/dev/null)"; then
  die "API error: ${err}"
fi

image="$(jq -c 'first(.steps[]? | select(.type == "model_output") | .content[]? | select(.type == "image"))' <<<"${response}" 2>/dev/null || true)"
if [[ -z "${image}" || "${image}" == "null" ]]; then
  text="$(jq -r '[.steps[]? | select(.type == "model_output") | .content[]? | select(.type == "text") | .text] | join("\n")' <<<"${response}" 2>/dev/null || true)"
  [[ -n "${text}" ]] && echo "${text}" >&2
  die "no image in response"
fi

if [[ -z "${output}" ]]; then
  case "$(jq -r '.mime_type // "image/png"' <<<"${image}")" in
    image/jpeg) ext=jpg ;;
    image/webp) ext=webp ;;
    *) ext=png ;;
  esac
  output="gemini-$(date +%Y%m%d-%H%M%S).${ext}"
fi

jq -r '.data' <<<"${image}" | base64 --decode >"${output}"
echo "Saved ${output}" >&2

[[ "${open_after}" -eq 1 ]] && open "${output}"
exit 0
