#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") <qr-image> [okta-domain [issuer]]

Enroll a TOTP method with Okta Verify and print its QR code to scan into
any authenticator app.

  qr-image     screenshot of the Okta Verify enrollment QR code
  okta-domain  your Okta hostname, e.g. acme.oktapreview.com or login.acme.com;
               a bare name without dots, e.g. acme, means acme.okta.com;
               defaults to the org URL in the QR code
  issuer       label to show in the authenticator app;
               defaults to the issuer in the QR code, then to okta-domain

Pass an empty okta-domain ("") to keep its default while setting issuer.

Requires trurl, qrencode, zbarimg, jq, and perl with URI::Escape.
EOF
}

die() {
  echo "$(basename "$0"): $*" >&2
  exit 1
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 || $# -gt 3 ]]; then
  usage >&2
  exit 1
fi

# Check for requirements
if ! command -v "trurl" > /dev/null; then
  die "trurl not found. Get the latest release here https://github.com/curl/trurl"
fi

if ! command -v "qrencode" > /dev/null; then
  die "qrencode not found. Get the latest release here https://github.com/fukuchi/libqrencode"
fi

if ! command -v "zbarimg" > /dev/null; then
  die "zbarimg not found. Get the latest release here https://github.com/mchehab/zbar"
fi

if ! command -v "jq" > /dev/null; then
  die "jq not found. Get the latest release here https://jqlang.github.io/jq/"
fi

if ! perl -MURI::Escape -e 1 2> /dev/null; then
  die "perl module URI::Escape not found. Install it with: cpan URI::Escape"
fi

###

qr_img=$1
domain=${2:-}
issuer=${3:-}

[[ -r "${qr_img}" ]] || die "cannot read QR image: ${qr_img}"
url=$(zbarimg -q --raw "${qr_img}") || die "no QR code found in ${qr_img}"

url_decoded=$(echo "${url}" | perl -MURI::Escape -ne 'print uri_unescape($_)')

email=$(echo "${url_decoded}" | trurl --url-file - -g '{host}')
authorization=$(echo "${url_decoded}" | trurl --url-file - -g '{query:t}')
authenticatorId=$(echo "${url_decoded}" | trurl --url-file - -g '{query:f}')

[[ -n "${authorization}" && -n "${authenticatorId}" ]] \
  || die "QR code is not an Okta Verify enrollment code: ${url}"

if [[ -z "${domain}" ]]; then
  org_url=$(echo "${url_decoded}" | trurl --url-file - -g '{query:s}')
  [[ -n "${org_url}" ]] || die "QR code has no org URL; pass okta-domain"
  domain=$(trurl --url "${org_url}" -g '{host}')
elif [[ "${domain}" != *.* ]]; then
  domain="${domain}.okta.com"
fi

if [[ -z "${issuer}" ]]; then
  issuer=$(echo "${url_decoded}" | trurl --url-file - -g '{query:issuer}')
fi
issuer=$(echo "${issuer:-${domain}}" | perl -MURI::Escape -ne 'chomp($_); print uri_escape($_)')

display_name="Okta Verify"

payload=$(cat <<EOF
{
	"authenticatorId": "${authenticatorId}",
	"device": {
		"clientInstanceBundleId": "com.okta.android.auth",
		"clientInstanceDeviceSdkVersion": "DeviceSDK 0.19.0",
		"clientInstanceVersion": "6.8.1",
		"clientInstanceKey": {
			"alg": "RS256",
			"e": "AQAB",
			"okta:isFipsCompliant": false,
			"okta:kpr": "SOFTWARE",
			"kty": "RSA",
			"use": "sig",
			"kid": "OpSRC6wLx4oPnqGBUuLz-WL7_knbK_UhClzjvt1cpOw",
			"n": "u0Y1ygDJ61AghDiEqeGW7lCv4iW2gLOON0Aw-Tm53xQW7qB94MUNVjua8KuYyxS-1pxf58u0pCpVhQxSgZJGht5Z7Gmc0geVuxRza3B_TFLd90SFlEdE3te6IkH28MqDu2rQtonYowVedHXZpOii6QBLPjqP6Zm3zx9r7WokpSvY9fnp8zjixuAUuA0XYhv6EwedfvSiz3t84N-nV0R1cN5Ni8os6sG4K6F8ZSr7E4aXTzvOfJIWa9MC1Lx_J4M7HIUuUH7LV7PN_h5yYk8b-2fW4g3_3h13mQ-blx2qMXclr6uuBc13tLLks7LzY3S34y2K060gHMMWCM4MQ77Mrw"
		},
		"deviceAttestation": {},
		"displayName": "${display_name}",
		"fullDiskEncryption": false,
		"isHardwareProtectionEnabled": false,
		"manufacturer": "unknown",
		"model": "Google",
		"osVersion": "25",
		"platform": "ANDROID",
		"rootPrivileges": true,
		"screenLock": false,
		"secureHardwarePresent": false
	},
	"key": "okta_verify",
	"methods": [
		{
			"isFipsCompliant": false,
			"supportUserVerification": false,
			"type": "totp"
		}
	]
}
EOF
)

# The response holds the TOTP shared secret, so it never outlives the script.
response=$(mktemp)
trap 'rm -f "${response}"' EXIT

status=$(curl --silent --show-error --compressed --connect-timeout 10 --request POST \
  --url "https://${domain}/idp/authenticators" \
  --header 'Accept: application/json; charset=UTF-8' \
  --header "Authorization: OTDT ${authorization}" \
  --header 'Content-Type: application/json; charset=UTF-8' \
  --header 'User-Agent: D2DD7D3915.com.okta.android.auth/6.8.1 DeviceSDK/0.19.0 Android/7.1.1 unknown/Google' \
  --data "${payload}" \
  --output "${response}" \
  --write-out '%{http_code}') || die "request to ${domain} failed"

if [[ "${status}" != 2* ]]; then
  echo "$(basename "$0"): Okta returned HTTP ${status}:" >&2
  cat "${response}" >&2
  echo >&2
  exit 1
fi

secret=$(jq -er '.methods[0].sharedSecret' "${response}") \
  || die "no sharedSecret in Okta response"

auth_url="otpauth://totp/${email}?secret=${secret}&issuer=${issuer}"
if ! qrencode -l H -t utf8 "${auth_url}"; then
  echo "$(basename "$0"): qrencode failed; enrollment already succeeded, so add this URL by hand:" >&2
  echo "${auth_url}" >&2
  exit 1
fi
