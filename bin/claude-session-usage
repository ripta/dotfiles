#!/usr/bin/env bash

usage() {
  cat <<'EOF'
Usage: claude-session-usage [options]

Summarize Claude Code session usage from transcripts under
~/.claude/projects. Reports token mix, cache hit rate, and per-model
and per-project breakdowns by day.

Options:
  -d, --days N      Window width when --from is not given (default: 7)
  -f, --from DATE   Start date (inclusive), YYYY-MM-DD; default: --to minus --days
  -t, --to DATE     End date (inclusive), YYYY-MM-DD; default: today
  -h, --help        Show this help and exit

Examples:
  claude-session-usage                     # last 7 days
  claude-session-usage -d 30               # last 30 days
  claude-session-usage -f 2026-04-01       # 2026-04-01 to today
  claude-session-usage -f 2026-04-01 -t 2026-04-30
EOF
}

die() { echo "Error: $*" >&2; exit 2; }

days=7
from=""
to=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -d|--days) days="${2-}"; shift 2 ;;
    --days=*)  days="${1#*=}"; shift ;;
    -f|--from) from="${2-}"; shift 2 ;;
    --from=*)  from="${1#*=}"; shift ;;
    -t|--to)   to="${2-}"; shift 2 ;;
    --to=*)    to="${1#*=}"; shift ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ "$days" =~ ^[0-9]+$ && "$days" -ge 1 ]] || die "--days must be a positive integer (got: '$days')"
for d in "$from" "$to"; do
  [[ -z "$d" || "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "dates must be YYYY-MM-DD (got: '$d')"
done

[[ -z "$to" ]]   && to=$(date +%Y-%m-%d)
[[ -z "$from" ]] && from=$(date -j -f "%Y-%m-%d" -v-"${days}d" "$to" +%Y-%m-%d)
[[ "$from" > "$to" ]] && die "--from ($from) is after --to ($to)"

find ~/.claude/projects -name "*.jsonl" -newermt "$from" -exec cat {} + 2>/dev/null \
  | jq -r --arg from "$from" --arg to "$to" '
      select(.message.usage and .message.model
             and (.timestamp[:10] >= $from)
             and (.timestamp[:10] <= $to)) |
      [
        (.timestamp[:10] // "?"),
        (.message.model // "?"),
        ((.cwd // "?") | split("/") | last),
        (.message.usage.input_tokens // 0),
        (.message.usage.output_tokens // 0),
        (.message.usage.cache_creation_input_tokens // 0),
        (.message.usage.cache_read_input_tokens // 0)
      ] | @tsv
    ' \
  | gawk -F'\t' -v from="$from" -v to="$to" '
      function fmt(n) {
        if (n >= 1e9) return sprintf("%.1fB", n/1e9)
        if (n >= 1e6) return sprintf("%.1fM", n/1e6)
        if (n >= 1e3) return sprintf("%.1fK", n/1e3)
        return sprintf("%d", n)
      }
      function pct(num, denom) {
        if (denom == 0) return "0.0%"
        return sprintf("%.1f%%", 100*num/denom)
      }
      {
        date=$1; model=$2; proj=$3
        in_=$4+0; out=$5+0; cw=$6+0; cr=$7+0
        prompts++
        tin += in_; tout += out; tcw += cw; tcr += cr
        dates[date]=1
        tot = in_ + out + cw + cr
        m_day[model,date] += tot
        p_day[proj,date] += tot
        m_total[model] += tot
        p_total[proj] += tot
        d_total[date] += tot
        grand += tot
      }
      END {
        if (prompts == 0) { printf "No data found between %s and %s\n", from, to; exit 1 }

        n_d = asorti(dates, sd)
        n_m = asorti(m_total, sm, "@val_num_desc")
        n_p = asorti(p_total, sp, "@val_num_desc")

        printf "Summary (%s to %s)\n", from, to
        printf "  Prompts:       %s\n", fmt(prompts)
        printf "  Input:         %s\n", fmt(tin)
        printf "  Output:        %s\n", fmt(tout)
        printf "  Cache write:   %s\n", fmt(tcw)
        printf "  Cache read:    %s\n", fmt(tcr)
        printf "  Cache hit:     %s\n", pct(tcr, tcr + tcw + tin)
        printf "\n"

        print "Total tokens by model x day"
        printf "  %-26s", ""
        for (j=1; j<=n_d; j++) printf " %8s", substr(sd[j], 6)
        printf " %10s\n", "Total"
        for (i=1; i<=n_m; i++) {
          printf "  %-26s", sm[i]
          for (j=1; j<=n_d; j++) printf " %8s", fmt(m_day[sm[i], sd[j]])
          printf " %10s\n", fmt(m_total[sm[i]])
        }
        printf "  %-26s", "Total"
        for (j=1; j<=n_d; j++) printf " %8s", fmt(d_total[sd[j]])
        printf " %10s\n", fmt(grand)
        printf "\n"

        top = (n_p < 15) ? n_p : 15
        print "Total tokens by project x day (top " top " of " n_p ")"
        printf "  %-26s", ""
        for (j=1; j<=n_d; j++) printf " %8s", substr(sd[j], 6)
        printf " %10s\n", "Total"
        other_total = 0
        for (i=1; i<=n_p; i++) {
          if (i <= top) {
            printf "  %-26s", substr(sp[i], 1, 26)
            for (j=1; j<=n_d; j++) printf " %8s", fmt(p_day[sp[i], sd[j]])
            printf " %10s\n", fmt(p_total[sp[i]])
          } else {
            for (j=1; j<=n_d; j++) other_day[sd[j]] += p_day[sp[i], sd[j]]
            other_total += p_total[sp[i]]
          }
        }
        if (n_p > top) {
          printf "  %-26s", "(other " (n_p - top) ")"
          for (j=1; j<=n_d; j++) printf " %8s", fmt(other_day[sd[j]])
          printf " %10s\n", fmt(other_total)
        }
        printf "  %-26s", "Total"
        for (j=1; j<=n_d; j++) printf " %8s", fmt(d_total[sd[j]])
        printf " %10s\n", fmt(grand)
      }
    '
