#!/usr/bin/env bash

cutoff=$(date -v-7d +%Y-%m-%d)

find ~/.claude/projects -mtime -7 -name "*.jsonl" -exec cat {} + 2>/dev/null \
  | jq -r --arg cutoff "$cutoff" '
      select(.message.usage and .message.model and (.timestamp[:10] >= $cutoff)) |
      [
        (.timestamp[:10] // "?"),
        (.message.model // "?"),
        ((.cwd // "?") | split("/") | last),
        (.message.usage.input_tokens // 0),
        (.message.usage.output_tokens // 0),
        (.message.usage.cache_creation_input_tokens // 0),
        (.message.usage.cache_read_input_tokens // 0)
      ] | @tsv
    ' \
  | gawk -F'\t' '
      function fmt(n) {
        if (n >= 1e9) return sprintf("%.1fB", n/1e9)
        if (n >= 1e6) return sprintf("%.1fM", n/1e6)
        if (n >= 1e3) return sprintf("%.1fK", n/1e3)
        return sprintf("%d", n)
      }
      function pct(num, denom) {
        if (denom == 0) return "0.0%"
        return sprintf("%.1f%%", 100*num/denom)
      }
      {
        date=$1; model=$2; proj=$3
        in_=$4+0; out=$5+0; cw=$6+0; cr=$7+0
        prompts++
        tin += in_; tout += out; tcw += cw; tcr += cr
        dates[date]=1
        tot = in_ + out + cw + cr
        m_day[model,date] += tot
        p_day[proj,date] += tot
        m_total[model] += tot
        p_total[proj] += tot
        d_total[date] += tot
        grand += tot
      }
      END {
        if (prompts == 0) { print "No data found in the last 7 days"; exit 1 }

        n_d = asorti(dates, sd)
        n_m = asorti(m_total, sm, "@val_num_desc")
        n_p = asorti(p_total, sp, "@val_num_desc")

        printf "Summary (last 7 days)\n"
        printf "  Prompts:       %s\n", fmt(prompts)
        printf "  Input:         %s\n", fmt(tin)
        printf "  Output:        %s\n", fmt(tout)
        printf "  Cache write:   %s\n", fmt(tcw)
        printf "  Cache read:    %s\n", fmt(tcr)
        printf "  Cache hit:     %s\n", pct(tcr, tcr + tcw + tin)
        printf "\n"

        print "Total tokens by model x day"
        printf "  %-26s", ""
        for (j=1; j<=n_d; j++) printf " %8s", substr(sd[j], 6)
        printf " %10s\n", "Total"
        for (i=1; i<=n_m; i++) {
          printf "  %-26s", sm[i]
          for (j=1; j<=n_d; j++) printf " %8s", fmt(m_day[sm[i], sd[j]])
          printf " %10s\n", fmt(m_total[sm[i]])
        }
        printf "  %-26s", "Total"
        for (j=1; j<=n_d; j++) printf " %8s", fmt(d_total[sd[j]])
        printf " %10s\n", fmt(grand)
        printf "\n"

        top = (n_p < 15) ? n_p : 15
        print "Total tokens by project x day (top " top " of " n_p ")"
        printf "  %-26s", ""
        for (j=1; j<=n_d; j++) printf " %8s", substr(sd[j], 6)
        printf " %10s\n", "Total"
        other_total = 0
        for (i=1; i<=n_p; i++) {
          if (i <= top) {
            printf "  %-26s", substr(sp[i], 1, 26)
            for (j=1; j<=n_d; j++) printf " %8s", fmt(p_day[sp[i], sd[j]])
            printf " %10s\n", fmt(p_total[sp[i]])
          } else {
            for (j=1; j<=n_d; j++) other_day[sd[j]] += p_day[sp[i], sd[j]]
            other_total += p_total[sp[i]]
          }
        }
        if (n_p > top) {
          printf "  %-26s", "(other " (n_p - top) ")"
          for (j=1; j<=n_d; j++) printf " %8s", fmt(other_day[sd[j]])
          printf " %10s\n", fmt(other_total)
        }
        printf "  %-26s", "Total"
        for (j=1; j<=n_d; j++) printf " %8s", fmt(d_total[sd[j]])
        printf " %10s\n", fmt(grand)
      }
    '
