#!/usr/bin/env bash
#
# Send a notification through the Pushover API.
#
# Usage: pushover [-t title] [-u url] [-l url-label] [-p priority] [-d device] [message...]
#
# The message comes from the arguments. With no arguments, it is read from STDIN.
#
# Priority is one of: silent, quiet, normal, high.
#
#   - silent: no notification at all. The message only shows in the app.
#   - quiet:  no sound or vibration.
#   - normal: follow the device settings. This is the default.
#   - high:   bypass quiet hours, and always make a sound.
#
# Environment:
#
#   PUSHOVER_USER_KEY             required
#   PUSHOVER_APP_TOKEN            required
#   PUSHOVER_DEFAULT_DEVICE_NAME  optional; when empty, all devices get the message
#
# Example: make test; pushover -p high -t "make test" "exited with $?"

set -euo pipefail

usage() {
  sed -n 's/^# \{0,1\}//; 3,14p' "$0" >&2
  exit 2
}

: "${PUSHOVER_USER_KEY:?must be set}"
: "${PUSHOVER_APP_TOKEN:?must be set}"

title=""
url=""
url_title=""
priority="normal"
device="${PUSHOVER_DEFAULT_DEVICE_NAME:-}"

while getopts ":t:u:l:p:d:h" opt
do
  case "${opt}" in
    t) title="${OPTARG}" ;;
    u) url="${OPTARG}" ;;
    l) url_title="${OPTARG}" ;;
    p) priority="${OPTARG}" ;;
    d) device="${OPTARG}" ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

case "${priority}" in
  silent) priority_num=-2 ;;
  quiet)  priority_num=-1 ;;
  normal) priority_num=0 ;;
  high)   priority_num=1 ;;
  *)
    echo "pushover: unknown priority '${priority}'" >&2
    usage
    ;;
esac

if [[ $# -gt 0 ]]
then
  message="$*"
else
  message="$(cat)"
fi

if [[ -z "${message}" ]]
then
  echo "pushover: message is empty" >&2
  exit 2
fi

# --form-string, unlike -F, does not treat a leading @ or < as a file to upload.
args=(
  --form-string "token=${PUSHOVER_APP_TOKEN}"
  --form-string "user=${PUSHOVER_USER_KEY}"
  --form-string "message=${message}"
  --form-string "priority=${priority_num}"
)
[[ -n "${title}" ]] && args+=(--form-string "title=${title}")
[[ -n "${url}" ]] && args+=(--form-string "url=${url}")
[[ -n "${url_title}" ]] && args+=(--form-string "url_title=${url_title}")
[[ -n "${device}" ]] && args+=(--form-string "device=${device}")

response="$(curl -sS "${args[@]}" https://api.pushover.net/1/messages.json)"

status="$(jq -r '.status' <<<"${response}" 2>/dev/null || true)"
if [[ "${status}" != "1" ]]
then
  echo "pushover: request failed" >&2
  jq -r '.errors[]?' <<<"${response}" >&2 2>/dev/null || echo "${response}" >&2
  exit 1
fi
