;; uv.sb - Seatbelt profile entry for `crated uv ...`.
;; All rules live in python-common.sb (shared with python.sb).

(version 1)
(deny default)

(import (string-append (param "HOME") "/.dotfiles/policies/sbpl/common.sb"))
(import (string-append (param "HOME") "/.dotfiles/policies/sbpl/homebrew.sb"))
(import (string-append (param "HOME") "/.dotfiles/policies/sbpl/python-common.sb"))

;; uv itself. /opt/homebrew/bin/uv is a symlink into the Cellar.
(allow file-read*
       file-map-executable
       process-exec
       (subpath "/opt/homebrew/Cellar/uv"))

;; Must stay last. See git-guard.sb.
(import (string-append (param "HOME") "/.dotfiles/policies/sbpl/git-guard.sb"))
