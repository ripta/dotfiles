#!/usr/bin/env bash
#
# Build a bookmarklet from readable source.
#
# Usage: build src/name.js > dist/name.txt
#
# The source is minified with terser, wrapped in an IIFE, and URL-encoded. The
# result is prefixed with "javascript:". The IIFE keeps the bookmarklet's value
# undefined, so the browser does not navigate away from the page. The wrap
# happens after minifying, because terser would otherwise inline the IIFE.

set -euo pipefail

TERSER_VERSION=5.51.2

if [[ $# -ne 1 ]]; then
  sed -n 's/^# \{0,1\}//; 3,5p' "$0" >&2
  exit 2
fi

npx --yes "terser@${TERSER_VERSION}" --compress --mangle --toplevel -- "$1" \
  | node -e '
      const body = require("fs").readFileSync(0, "utf8").trim();
      const code = "(function(){" + body + "})();";
      console.log("javascript:" + encodeURIComponent(code));
    '
